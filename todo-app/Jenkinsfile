pipeline {
    agent any
    environment {
        APP_NAME = 'todo-app'
        REGISTRY = 'registry-raheman.in'
        GIT_CREDENTIALS_ID = 'GIT_TOKEN'
        INFRA_REPO = 'https://github.com/Git-Raheman/infra.git'
    }
    triggers {
        pollSCM('H/2 * * * *')
    }
    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build-Images') {
            steps {
                script {
                    sh "docker build -t ${REGISTRY}/${APP_NAME}-backend:${BUILD_NUMBER} ./${APP_NAME}/backend"
                    sh "docker build -t ${REGISTRY}/${APP_NAME}-frontend:${BUILD_NUMBER} ./${APP_NAME}/frontend"
                    sh "docker build -t ${REGISTRY}/${APP_NAME}-nginx:${BUILD_NUMBER} ./${APP_NAME}/nginx"
                }
            }
        }
        stage('Push-Images') {
            steps {
                script {
                    sh "docker push ${REGISTRY}/${APP_NAME}-backend:${BUILD_NUMBER}"
                    sh "docker push ${REGISTRY}/${APP_NAME}-frontend:${BUILD_NUMBER}"
                    sh "docker push ${REGISTRY}/${APP_NAME}-nginx:${BUILD_NUMBER}"
                    sh "docker tag ${REGISTRY}/${APP_NAME}-backend:${BUILD_NUMBER} ${REGISTRY}/${APP_NAME}-backend:latest"
                    sh "docker tag ${REGISTRY}/${APP_NAME}-frontend:${BUILD_NUMBER} ${REGISTRY}/${APP_NAME}-frontend:latest"
                    sh "docker tag ${REGISTRY}/${APP_NAME}-nginx:${BUILD_NUMBER} ${REGISTRY}/${APP_NAME}-nginx:latest"
                    sh "docker push ${REGISTRY}/${APP_NAME}-backend:latest"
                    sh "docker push ${REGISTRY}/${APP_NAME}-frontend:latest"
                    sh "docker push ${REGISTRY}/${APP_NAME}-nginx:latest"
                }
            }
        }
        stage('Update-Infra') {
            steps {
                script {
                    withCredentials([string(credentialsId: GIT_CREDENTIALS_ID, variable: 'GIT_TOKEN')]) {
                        sh """
                            git clone https://\${GIT_TOKEN}@github.com/Git-Raheman/infra.git
                            cd infra/${APP_NAME}
                            sed -i "s|image: ${REGISTRY}/${APP_NAME}-backend:.*|image: ${REGISTRY}/${APP_NAME}-backend:${BUILD_NUMBER}|g" deployment.yaml
                            sed -i "s|image: ${REGISTRY}/${APP_NAME}-frontend:.*|image: ${REGISTRY}/${APP_NAME}-frontend:${BUILD_NUMBER}|g" deployment.yaml
                            sed -i "s|image: ${REGISTRY}/${APP_NAME}-nginx:.*|image: ${REGISTRY}/${APP_NAME}-nginx:${BUILD_NUMBER}|g" deployment.yaml
                            git config user.email "jenkins@raheman.in"
                            git config user.name "Jenkins Bot"
                            git add deployment.yaml
                            git commit -m "Update ${APP_NAME} images to build ${BUILD_NUMBER}"
                            git push origin main
                        """
                    }
                }
            }
        }
        stage('Done') {
            steps {
                echo "Pipeline finished successfully for ${APP_NAME} build ${BUILD_NUMBER}"
            }
        }
    }
}